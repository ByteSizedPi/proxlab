# Komodo Core environment — copy to compose.env and fill in.
#   cp compose.env.example compose.env
# compose.env is gitignored: it holds the database password and JWT secret.
#
# ⚠️ If a Mongo volume already exists, keep its existing database
# credentials. MONGO_INITDB_ROOT_* is only read when initialising an EMPTY
# data directory, so new credentials against an existing volume are ignored
# and Core then fails to authenticate — with no error naming the cause.
#
# Full reference for every option:
#   https://github.com/moghtech/komodo/blob/main/config/core.config.toml

# --- Image tag ---
# Floating major tag, which is also what upstream's compose file defaults to.
# Security fixes and features arrive without anyone having to remember them.
#
# ⚠️ Core and Periphery versions MUST match or the server goes yellow with a
# version mismatch, and they are installed by different mechanisms — Core here
# by compose, Periphery by setup-periphery.py. Nothing aligns them by itself.
#
# Both track `2`, and ONE thing updates both: ../scripts/update-komodo.sh,
# run weekly by komodo-update.timer. Updating them in a single pass is what
# makes drift impossible rather than eventually-corrected.
#
# Komodo deliberately does not manage Komodo — see the note at the foot of
# resources/stacks.toml for what that cost when it was tried.
#
# Pinning an exact version is still the right move if you ever need to freeze
# or roll back; set it here AND re-run the installer at the same version, or
# the two drift apart:
#
#   sudo python3 /tmp/setup-periphery.py --version v2.3.0
#
COMPOSE_KOMODO_IMAGE_TAG=2

# --- Host paths ---
COMPOSE_KOMODO_BACKUPS_PATH=/mnt/docker-data/komodo/backups

# --- Database (must match the existing Mongo volume's credentials) ---
KOMODO_DATABASE_USERNAME=komodo
KOMODO_DATABASE_PASSWORD=CHANGE_ME

# --- Public address (must match what the browser hits, and any OAuth app) ---
# Komodo builds the URLs it hands you from this value, so a wrong entry
# produces links that point nowhere — with no error at either end. (Webhook
# URLs are the exception: KOMODO_WEBHOOK_BASE_URL below overrides this for
# those, which is why they kept working while this said 10.42.0.205.)
#
# Traefik fronts the UI as of 2026-08-01 — see
# stacks/platform/traefik/dynamic/komodo.yml. Serving it over TLS is also what
# makes the UI's copy-to-clipboard buttons work: navigator.clipboard is only
# available in a secure context, so on plain HTTP they silently do nothing.
#
# ⚠️ ORDER MATTERS. Set this only AFTER the `*.admin.jjventer.co.za` wildcard
# rewrite exists in AdGuard. Point it at a name that does not resolve yet and
# every link Komodo generates is dead until DNS catches up.
#
# ⚠️ Core does NOT lose its published 9120. http://10.42.0.205:9120 stays as
# the break-glass route for when a bad Traefik config takes the proxy down —
# otherwise the tool you need to fix Traefik sits behind the broken Traefik.
KOMODO_HOST=https://komodo.admin.jjventer.co.za
KOMODO_TITLE=Komodo

# --- Auth ---
KOMODO_LOCAL_AUTH=true
KOMODO_DISABLE_USER_REGISTRATION=true

# The first admin, created on first startup against an empty database.
# These two MUST be set alongside DISABLE_USER_REGISTRATION=true above —
# registration is off, so with no init admin there is no way to log in and
# no recovery flow short of editing Mongo by hand.
# Only read when the database is empty; changing them later does nothing.
KOMODO_INIT_ADMIN_USERNAME=admin
KOMODO_INIT_ADMIN_PASSWORD=CHANGE_ME

# Persist logins across restarts. Empty = new random secret each boot,
# which logs everyone out on every redeploy of this stack.
KOMODO_JWT_SECRET=CHANGE_ME

# --- Webhooks ---
# This exact value goes in the GitHub webhook "Secret" field.
# Generate with: openssl rand -hex 32
KOMODO_WEBHOOK_SECRET=CHANGE_ME

# Public base URL Komodo uses when GENERATING webhook URLs, separate from
# KOMODO_HOST. This is what lets the UI stay private on the LAN while GitHub
# still reaches the listener.
#
# app-prod has no public IP and the ISP won't forward, so inbound arrives via
# a Cloudflare Tunnel (stacks/cloudflared) that publishes ONLY the /listener
# path. Without this set, Komodo hands you webhook URLs pointing at
# KOMODO_HOST — a private address GitHub cannot reach, and the delivery just
# times out with nothing obviously misconfigured at either end.
KOMODO_WEBHOOK_BASE_URL=https://hooks.jjventer.co.za

# --- GitOps hardening (enable once syncs are driving everything) ---
# Makes the UI read-only so config can only change via git. Leave false
# until the Resource Sync is confirmed working, or you'll lock yourself
# out of fixing things in the UI.
KOMODO_UI_WRITE_DISABLED=false

# How often Komodo polls resources for updates when no webhook fires.
# Webhooks make this a backstop rather than the primary trigger.
KOMODO_RESOURCE_POLL_INTERVAL=5-min
