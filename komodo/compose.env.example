# Komodo Core environment — copy to compose.env and fill in.
#   cp compose.env.example compose.env
# compose.env is gitignored: it holds the database password and JWT secret.
#
# Reconcile this against the compose.env already on app-prod before
# overwriting anything — keep the existing database credentials, or Core
# will fail to authenticate against the existing Mongo volume.
#
# Full reference for every option:
#   https://github.com/moghtech/komodo/blob/main/config/core.config.toml

# --- Image tag ---
COMPOSE_KOMODO_IMAGE_TAG=2

# --- Host paths ---
COMPOSE_KOMODO_BACKUPS_PATH=/mnt/docker-data/komodo/backups

# --- Database (must match the existing Mongo volume's credentials) ---
KOMODO_DATABASE_USERNAME=komodo
KOMODO_DATABASE_PASSWORD=CHANGE_ME

# --- Public address (must match what the browser hits, and any OAuth app) ---
KOMODO_HOST=https://komodo.jj.home
KOMODO_TITLE=Komodo

# --- Auth ---
KOMODO_LOCAL_AUTH=true
KOMODO_DISABLE_USER_REGISTRATION=true
# Persist logins across restarts. Empty = new random secret each boot,
# which logs everyone out on every redeploy of this stack.
KOMODO_JWT_SECRET=CHANGE_ME

# --- Webhooks ---
# This exact value goes in the GitHub webhook "Secret" field.
# Generate with: openssl rand -hex 32
KOMODO_WEBHOOK_SECRET=CHANGE_ME

# --- GitOps hardening (enable once syncs are driving everything) ---
# Makes the UI read-only so config can only change via git. Leave false
# until the Resource Sync is confirmed working, or you'll lock yourself
# out of fixing things in the UI.
KOMODO_UI_WRITE_DISABLED=false

# How often Komodo polls resources for updates when no webhook fires.
# Webhooks make this a backstop rather than the primary trigger.
KOMODO_RESOURCE_POLL_INTERVAL=5-min
