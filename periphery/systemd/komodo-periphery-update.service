[Unit]
Description=Update Komodo Periphery to the latest release
Documentation=https://komo.do/docs/setup/connect-servers
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot

# ⚠️ REQUIRED. systemd starts services with a near-empty environment, and
# setup-periphery.py does `home_dir = os.environ['HOME']` at the top of
# load_paths() — before it branches on root vs --user. A root install never
# uses the value, but reading it still raises KeyError: 'HOME' and the whole
# run dies before printing anything useful. Verified on app-prod 2026-08-01.
Environment=HOME=/root

# Upstream explicitly supports re-running this installer:
#   "This script can be run multiple times without issue, and it won't change
#    existing config after the first run. Just run it again after a Komodo
#    version release, and it will update the periphery version."
#
# ⚠️ Download first, THEN run — do not pipe curl into python3. The installer
# escalates privileges, and when stdin is the pipe the password prompt cannot
# read the terminal. It fails with a misleading "Failed to download binary...
# Did you provide a valid tag?" that points nowhere near the real cause.
# Under systemd we are already root so there is no prompt, but the two-step
# form is kept so this file matches the documented manual procedure.
ExecStart=/usr/bin/bash -c '\
  set -euo pipefail; \
  curl -fsSL -o /tmp/setup-periphery.py \
    https://raw.githubusercontent.com/moghtech/komodo/main/scripts/setup-periphery.py; \
  /usr/bin/python3 /tmp/setup-periphery.py; \
  rm -f /tmp/setup-periphery.py'

# The installer replaces the binary; restart so the new one is actually loaded.
# Harmless if the installer already did it.
ExecStartPost=/usr/bin/systemctl restart periphery

# ⚠️ Do NOT add Restart=on-failure here. On a Type=oneshot unit that produces
# an endless retry loop — the unit sits in `activating (auto-restart)` and
# re-runs forever on a permanent failure like a bad path or a missing
# environment variable, which is exactly what happened the first time this
# ran. The timer already provides the retry cadence, and Persistent=true
# covers a run missed because the machine was off.
