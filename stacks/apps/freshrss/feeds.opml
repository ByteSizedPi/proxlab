<?xml version="1.0" encoding="UTF-8"?>
<!--
  Starter subscription list for FreshRSS.

  The running container never reads this file. It is mounted read only at
  /opml/feeds.opml and imported once by hand. The command is in compose.yaml,
  above the volume that mounts it.

  Importing is manual on purpose. If it ran on every deploy, every feed you
  unsubscribed from would come back the next time a commit touched this
  stack. Re-running the import is safe: FreshRSS matches on xmlUrl and skips
  feeds that already exist.

  Every URL below returned HTTP 200 and XML when checked on 2026-09-08.
  Reddit is deliberately absent: www.reddit.com/r/*.rss answers 403 and 429 to
  anything that is not a browser, so those feeds would fail on every refresh.
-->
<opml version="2.0">
  <head>
    <title>jj homelab starter feeds</title>
  </head>
  <body>
    <outline text="Homelab" title="Homelab">
      <outline type="rss" text="selfh.st" title="selfh.st"
               xmlUrl="https://selfh.st/rss/" htmlUrl="https://selfh.st/"/>
      <outline type="rss" text="Proxmox VE announcements" title="Proxmox VE announcements"
               xmlUrl="https://forum.proxmox.com/forums/proxmox-ve-announcements.16/index.rss"
               htmlUrl="https://forum.proxmox.com/forums/proxmox-ve-announcements.16/"/>
      <outline type="rss" text="Traefik blog" title="Traefik blog"
               xmlUrl="https://traefik.io/rss.xml" htmlUrl="https://traefik.io/blog/"/>
      <outline type="rss" text="Tailscale blog" title="Tailscale blog"
               xmlUrl="https://tailscale.com/blog/index.xml" htmlUrl="https://tailscale.com/blog/"/>
      <outline type="rss" text="Docker blog" title="Docker blog"
               xmlUrl="https://www.docker.com/feed/" htmlUrl="https://www.docker.com/blog/"/>
      <outline type="rss" text="Jellyfin blog" title="Jellyfin blog"
               xmlUrl="https://jellyfin.org/index.xml" htmlUrl="https://jellyfin.org/posts/"/>
    </outline>
    <outline text="Releases" title="Releases">
      <outline type="rss" text="Komodo releases" title="Komodo releases"
               xmlUrl="https://github.com/moghtech/komodo/releases.atom"
               htmlUrl="https://github.com/moghtech/komodo/releases"/>
      <outline type="rss" text="Traefik releases" title="Traefik releases"
               xmlUrl="https://github.com/traefik/traefik/releases.atom"
               htmlUrl="https://github.com/traefik/traefik/releases"/>
      <outline type="rss" text="Jellyfin releases" title="Jellyfin releases"
               xmlUrl="https://github.com/jellyfin/jellyfin/releases.atom"
               htmlUrl="https://github.com/jellyfin/jellyfin/releases"/>
      <outline type="rss" text="Immich releases" title="Immich releases"
               xmlUrl="https://github.com/immich-app/immich/releases.atom"
               htmlUrl="https://github.com/immich-app/immich/releases"/>
      <outline type="rss" text="Authentik releases" title="Authentik releases"
               xmlUrl="https://github.com/goauthentik/authentik/releases.atom"
               htmlUrl="https://github.com/goauthentik/authentik/releases"/>
      <outline type="rss" text="CrowdSec releases" title="CrowdSec releases"
               xmlUrl="https://github.com/crowdsecurity/crowdsec/releases.atom"
               htmlUrl="https://github.com/crowdsecurity/crowdsec/releases"/>
    </outline>
    <outline text="Rust" title="Rust">
      <outline type="rss" text="This Week in Rust" title="This Week in Rust"
               xmlUrl="https://this-week-in-rust.org/rss.xml" htmlUrl="https://this-week-in-rust.org/"/>
      <outline type="rss" text="Rust Blog" title="Rust Blog"
               xmlUrl="https://blog.rust-lang.org/feed.xml" htmlUrl="https://blog.rust-lang.org/"/>
      <outline type="rss" text="Inside Rust" title="Inside Rust"
               xmlUrl="https://blog.rust-lang.org/inside-rust/feed.xml"
               htmlUrl="https://blog.rust-lang.org/inside-rust/"/>
      <outline type="rss" text="Rust releases" title="Rust releases"
               xmlUrl="https://github.com/rust-lang/rust/releases.atom"
               htmlUrl="https://github.com/rust-lang/rust/releases"/>
      <outline type="rss" text="RustSec advisories" title="RustSec advisories"
               xmlUrl="https://rustsec.org/feed.xml" htmlUrl="https://rustsec.org/advisories/"/>
      <outline type="rss" text="fasterthanli.me" title="fasterthanli.me"
               xmlUrl="https://fasterthanli.me/index.xml" htmlUrl="https://fasterthanli.me/"/>
      <outline type="rss" text="without.boats" title="without.boats"
               xmlUrl="https://without.boats/index.xml" htmlUrl="https://without.boats/"/>
    </outline>
    <outline text="Security" title="Security">
      <outline type="rss" text="oss-security" title="oss-security"
               xmlUrl="https://seclists.org/rss/oss-sec.rss" htmlUrl="https://seclists.org/oss-sec/"/>
      <outline type="rss" text="CISA advisories" title="CISA advisories"
               xmlUrl="https://www.cisa.gov/cybersecurity-advisories/all.xml"
               htmlUrl="https://www.cisa.gov/cybersecurity-advisories"/>
      <outline type="rss" text="Krebs on Security" title="Krebs on Security"
               xmlUrl="https://krebsonsecurity.com/feed/" htmlUrl="https://krebsonsecurity.com/"/>
    </outline>
    <outline text="Tech news" title="Tech news">
      <outline type="rss" text="Hacker News front page" title="Hacker News front page"
               xmlUrl="https://hnrss.org/frontpage" htmlUrl="https://news.ycombinator.com/"/>
      <outline type="rss" text="LWN" title="LWN"
               xmlUrl="https://lwn.net/headlines/newrss" htmlUrl="https://lwn.net/"/>
      <outline type="rss" text="Ars Technica" title="Ars Technica"
               xmlUrl="https://feeds.arstechnica.com/arstechnica/index" htmlUrl="https://arstechnica.com/"/>
      <outline type="rss" text="Phoronix" title="Phoronix"
               xmlUrl="https://www.phoronix.com/rss.php" htmlUrl="https://www.phoronix.com/"/>
      <outline type="rss" text="Fedora Magazine" title="Fedora Magazine"
               xmlUrl="https://fedoramagazine.org/feed/" htmlUrl="https://fedoramagazine.org/"/>
    </outline>
  </body>
</opml>
