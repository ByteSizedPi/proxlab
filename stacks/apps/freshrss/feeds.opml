<?xml version="1.0" encoding="UTF-8"?>
<!--
  FreshRSS subscription list, rebuilt 2026-11-23 for the daily digest.

  FreshRSS is the single collector: the digest job (stacks/apps/digest) reads
  new items from FreshRSS over its API, and JJ reads the same feeds on his
  phone. Add or remove a source here, then import it (command in
  compose.yaml). An import only ADDS feeds, and it does not move a feed
  that already exists to a new category. Remove or move feeds in the
  FreshRSS UI (Subscription management).

  Every URL returned HTTP 200 and XML from pve-prod on 2026-11-23.
  Dropped as dead: News24 (no working feed URL), AP News (403).
  Removed on purpose: the Rust, security and Phoronix/Fedora groups.
-->
<opml version="2.0">
  <head>
    <title>jj feeds for FreshRSS and the daily digest</title>
  </head>
  <body>
    <!-- Release notes for what runs on jj-laptop. -->
    <outline text="Desktop releases" title="Desktop releases">
      <outline type="rss" text="Hyprland" title="Hyprland" xmlUrl="https://github.com/hyprwm/Hyprland/releases.atom"/>
      <outline type="rss" text="niri" title="niri" xmlUrl="https://github.com/YaLTeR/niri/releases.atom"/>
      <outline type="rss" text="Noctalia" title="Noctalia" xmlUrl="https://github.com/noctalia-dev/noctalia-shell/releases.atom"/>
      <outline type="rss" text="zellij" title="zellij" xmlUrl="https://github.com/zellij-org/zellij/releases.atom"/>
      <outline type="rss" text="kitty" title="kitty" xmlUrl="https://github.com/kovidgoyal/kitty/releases.atom"/>
      <outline type="rss" text="Neovim" title="Neovim" xmlUrl="https://github.com/neovim/neovim/releases.atom"/>
      <outline type="rss" text="yazi" title="yazi" xmlUrl="https://github.com/sxyazi/yazi/releases.atom"/>
      <outline type="rss" text="Zed" title="Zed" xmlUrl="https://github.com/zed-industries/zed/releases.atom"/>
      <outline type="rss" text="Zen browser" title="Zen browser" xmlUrl="https://github.com/zen-browser/desktop/releases.atom"/>
      <outline type="rss" text="RapidRAW" title="RapidRAW" xmlUrl="https://github.com/CyberTimon/RapidRAW/releases.atom"/>
      <outline type="rss" text="espanso" title="espanso" xmlUrl="https://github.com/espanso/espanso/releases.atom"/>
      <outline type="rss" text="Obsidian" title="Obsidian" xmlUrl="https://github.com/obsidianmd/obsidian-releases/releases.atom"/>
      <outline type="rss" text="Claude Code" title="Claude Code" xmlUrl="https://github.com/anthropics/claude-code/releases.atom"/>
    </outline>
    <!-- Release notes for services on pve-prod. -->
    <outline text="Homelab releases" title="Homelab releases">
      <outline type="rss" text="Komodo" title="Komodo" xmlUrl="https://github.com/moghtech/komodo/releases.atom"/>
      <outline type="rss" text="Traefik" title="Traefik" xmlUrl="https://github.com/traefik/traefik/releases.atom"/>
      <outline type="rss" text="Jellyfin" title="Jellyfin" xmlUrl="https://github.com/jellyfin/jellyfin/releases.atom"/>
      <outline type="rss" text="Immich" title="Immich" xmlUrl="https://github.com/immich-app/immich/releases.atom"/>
      <outline type="rss" text="Authentik" title="Authentik" xmlUrl="https://github.com/goauthentik/authentik/releases.atom"/>
      <outline type="rss" text="Homarr" title="Homarr" xmlUrl="https://github.com/homarr-labs/homarr/releases.atom"/>
      <outline type="rss" text="Beszel" title="Beszel" xmlUrl="https://github.com/henrygd/beszel/releases.atom"/>
      <outline type="rss" text="gluetun" title="gluetun" xmlUrl="https://github.com/qdm12/gluetun/releases.atom"/>
    </outline>
    <!-- Few, high-signal sources. HN only above 300 points. -->
    <outline text="Tech news" title="Tech news">
      <outline type="rss" text="LWN" title="LWN" xmlUrl="https://lwn.net/headlines/rss"/>
      <outline type="rss" text="selfh.st" title="selfh.st" xmlUrl="https://selfh.st/rss/"/>
      <outline type="rss" text="Hacker News 300+" title="Hacker News 300+" xmlUrl="https://hnrss.org/frontpage?points=300"/>
      <outline type="rss" text="The Verge" title="The Verge" xmlUrl="https://www.theverge.com/rss/index.xml"/>
      <outline type="rss" text="Ars Technica" title="Ars Technica" xmlUrl="https://feeds.arstechnica.com/arstechnica/index"/>
      <outline type="rss" text="TechCrunch" title="TechCrunch" xmlUrl="https://techcrunch.com/feed/"/>
    </outline>

    <outline text="World news" title="World news">
      <outline type="rss" text="BBC World" title="BBC World" xmlUrl="https://feeds.bbci.co.uk/news/world/rss.xml"/>
      <outline type="rss" text="Al Jazeera" title="Al Jazeera" xmlUrl="https://www.aljazeera.com/xml/rss/all.xml"/>
      <outline type="rss" text="The Guardian World" title="The Guardian World" xmlUrl="https://www.theguardian.com/world/rss"/>
    </outline>

    <outline text="South Africa" title="South Africa">
      <outline type="rss" text="Daily Maverick" title="Daily Maverick" xmlUrl="https://www.dailymaverick.co.za/dmrss/"/>
      <outline type="rss" text="BusinessTech" title="BusinessTech" xmlUrl="https://businesstech.co.za/news/feed/"/>
      <outline type="rss" text="Moneyweb" title="Moneyweb" xmlUrl="https://www.moneyweb.co.za/feed/"/>
    </outline>
    <!-- FT and Economist are paywalled: headlines and summaries only. -->
    <outline text="Business and markets" title="Business and markets">
      <outline type="rss" text="Financial Times" title="Financial Times" xmlUrl="https://www.ft.com/rss/home"/>
      <outline type="rss" text="The Economist business" title="The Economist business" xmlUrl="https://www.economist.com/business/rss.xml"/>
      <outline type="rss" text="The Economist finance" title="The Economist finance" xmlUrl="https://www.economist.com/finance-and-economics/rss.xml"/>
      <outline type="rss" text="CNBC Markets" title="CNBC Markets" xmlUrl="https://www.cnbc.com/id/10000664/device/rss/rss.html"/>
      <outline type="rss" text="BBC Business" title="BBC Business" xmlUrl="https://feeds.bbci.co.uk/news/business/rss.xml"/>
    </outline>
  </body>
</opml>
