# Immich — non-secret config. Committed.
# DB_PASSWORD is NOT here. It is a Komodo Variable marked Secret and arrives
# via komodo.env — see the entry in komodo/resources/stacks.toml.

# --- Version ---
# `release` tracks Immich's stable channel. Note that `auto_update` is OFF for
# this stack (unlike every *arr stack), because Immich runs irreversible
# database migrations on version bumps. Deploy it deliberately, after reading
# the release notes, not because a digest changed at 03:00.
IMMICH_VERSION=release

# --- Storage ---
#
# Two DIFFERENT kinds of storage, and the distinction is the whole design:
#
#   UPLOAD_LOCATION   Immich OWNS this. Phone uploads land here and Immich
#                     organises them by its storage template. Also holds
#                     thumbs/ and encoded-video/, which are regenerable and
#                     should be EXCLUDED from restic.
#
#   External Libraries  Immich only READS these. Mounted :ro in compose.yaml
#                     at /mnt/safe/photos and /mnt/safe/photos-raw. They are
#                     not configured here — they are added once in the Immich
#                     UI under Administration > External Libraries, using
#                     those exact paths.
#
# Never upload into the External Library paths. Uploading hands ownership to
# Immich's storage template, which would undo the folder organisation that
# /mnt/safe exists to preserve.
UPLOAD_LOCATION=/mnt/safe/immich

# --- Database ---
# DB_DATA_LOCATION is not used; compose.yaml binds ${CONFIG_ROOT}/immich/postgres
# directly so the path follows the shared CONFIG_ROOT convention.
DB_USERNAME=postgres
DB_DATABASE_NAME=immich
