# AirVPN, NON-SECRET values for gluetun. This file IS committed.
#
# Taken from AirVPN_Netherlands_UDP-1637-Entry3.conf (2026-11-23). The two
# keys in that file are secrets and live in Komodo Variables instead:
# AIRVPN_WG_PRIVATE_KEY and AIRVPN_WG_PRESHARED_KEY.

# [Interface] Address. IPv4 only: the .conf also lists an IPv6 address, but
# Docker on pve-prod has no IPv6, and the gluetun wiki says to drop it then.
AIRVPN_WG_ADDRESSES=10.146.82.80/32

# [Interface] MTU from the .conf.
AIRVPN_WG_MTU=1320

# gluetun picks an AirVPN Netherlands server itself from its server list.
# Not pinned to the .conf's nl3 entry: the wiki warns a pinned hostname
# breaks the container if it leaves gluetun's list.
AIRVPN_SERVER_COUNTRIES=Netherlands

# Port forwarded by AirVPN to this account (airvpn.org/ports).
# qBittorrent's listening port must be the same number.
AIRVPN_FORWARDED_PORT=64023
