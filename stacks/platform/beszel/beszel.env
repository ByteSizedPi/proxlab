# Beszel-specific, NON-SECRET config. This file IS committed.
#
# Shared values (TZ/CONFIG_ROOT/ADMIN_DOMAIN) live in ../../common.env.

# The hub's PUBLIC ed25519 key. The agent accepts connections only from the
# holder of the matching private key, which never leaves
# ${CONFIG_ROOT}/beszel/hub/. A public key is safe to commit.
# Read on 2026-11-23 with `ssh-keygen -y -f ${CONFIG_ROOT}/beszel/hub/id_ed25519`.
BESZEL_HUB_PUBLIC_KEY=ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIGPWVqYZcDdlF5l0nx5DYvqOfd+wTld9ASycsdNaQtwF
