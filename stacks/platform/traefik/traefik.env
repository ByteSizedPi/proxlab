# Traefik-specific, NON-SECRET config. This file IS committed.
#
# Shared values (PUID/PGID/TZ/CONFIG_ROOT/DATA_ROOT) live in ../../common.env.
# Values here win over common.env — both are passed as --env-file, later wins.
#
# The two credentials this stack needs are NOT here:
#   CF_DNS_API_TOKEN        Cloudflare token for the ACME DNS-01 challenge
#   TRAEFIK_DASHBOARD_AUTH  htpasswd line for the dashboard basicauth
# Both are Komodo Variables with "Secret" enabled, interpolated into the
# generated komodo.env at deploy time. See komodo/resources/stacks.toml.

# --- Identity ---
# Where Let's Encrypt sends expiry warnings if renewal ever stops working.
# Worth pointing at an address you actually read — a silent renewal failure
# surfaces as every service going untrusted 30 days later.
ACME_EMAIL=johann12venter@gmail.com

# --- Routing ---
# The tailnet-only half of the naming split (see docs/ARCHITECTURE.md):
# *.admin.jjventer.co.za is infrastructure, *.jjventer.co.za is public.
# Everything on app-prod is admin-side for now — the ISP blocks inbound, so
# nothing here is publicly reachable regardless.
#
# One wildcard cert is issued for *.${ADMIN_DOMAIN} plus ${ADMIN_DOMAIN}
# itself. Note that a wildcard covers exactly ONE label: it matches
# prowlarr.admin.jjventer.co.za but NOT a.b.admin.jjventer.co.za. Keep
# service hostnames flat.
ADMIN_DOMAIN=admin.jjventer.co.za
